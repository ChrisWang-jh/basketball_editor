# Keep only application code, tests, dependency manifests and documentation.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/pyproject.toml
!/requirements*.txt
!/run.py
!/stitch_ui.py
!/basketeditor/
!/scripts/
!/tests/
!/third_party/

# Model repositories are submodules; the parent stores only commit references.
/third_party/*
!/third_party/sam2
!/third_party/dinov3

# Generated files are ignored even when tools write into source directories.
__pycache__/
*.py[cod]
.cache/
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.venv/
venv/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
*.log
*.tmp
*.bak
*.[mM][pP]4
*.[mM]4[vV]
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM][pP][eE][gG]
*.[mM][pP][gG]
*.[wW][eE][bB][mM]
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz
*.npy
*.zip
*.tar
*.gz
